{
  "name": "pashufeed-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Cattle feed shop and farm management platform for dairy farmers and shop owners.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite --config frontend/vite.config.ts\" \"npm:server\"",
    "server": "tsx watch backend/server/index.ts",
    "build": "npm run build:api && vite build --config frontend/vite.config.ts",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview --config frontend/vite.config.ts",
    "lint": "tsc --noEmit",
    "db:init": "tsx backend/server/migrate.ts",
    "db:seed": "tsx backend/server/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
