# Copy this file to `.env` and fill in your values.

# Required for the Dr. Pashu AI advisor. Get a key at https://aistudio.google.com/apikey
# Without it the server still starts and the chat widget runs in clearly-labelled demo mode.
GEMINI_API_KEY="your-gemini-api-key"

# Optional. Model used for chat replies.
GEMINI_MODEL="gemini-2.5-flash"

# Optional. Port for the Express API. The Vite dev server proxies /api here.
PORT=3001
