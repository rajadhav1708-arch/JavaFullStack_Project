# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and must never be committed.

# PostgreSQL connection string. Any Postgres host works:
#   local Docker : postgresql://postgres:pashufeed@localhost:5432/pashufeed
#   Neon / Supabase: copy the pooled connection string they give you
# The app still runs without this, but accounts are then disabled and
# `/api/auth` returns 503. The storefront, AI quiz and chatbot keep working.
# Create the tables with `npm run db:init`.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign session cookies. Use any long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Required for the Dr. Pashu AI advisor. Get a key at https://aistudio.google.com/apikey
# Without it the server still starts and the chat widget runs in clearly-labelled demo mode.
GEMINI_API_KEY="your-gemini-api-key"

# Optional. Model used for chat replies.
GEMINI_MODEL="gemini-2.5-flash"

# Optional. Port for the Express API. The Vite dev server proxies /api here.
PORT=3001

# Optional. Set to "production" in production so session cookies are HTTPS-only.
NODE_ENV=development